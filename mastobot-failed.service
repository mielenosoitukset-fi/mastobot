[Unit]
Description=Alert the maintainer that mastobot stopped
# Started by OnFailure= in mastobot.service. Uses the server's shared alert
# script (Bark push, e-mail fallback) and its root-only settings file.

[Service]
Type=oneshot
Environment=MONITOR_UNIT=mastobot.service
Environment="ALERT_LABEL=Mastobot stopped"
Environment=BARK_ALERT_GROUP=mastobot
EnvironmentFile=-/etc/mielenosoitukset-alerts.env
ExecStart=/usr/bin/logger -p user.err -t mastobot "mastobot stopped; read its journal"
ExecStart=/var/www/mielenosoitukset_fi/deploy/backup/backup-notify.py
